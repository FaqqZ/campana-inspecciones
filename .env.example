# Opcional: copiar a .env junto al docker-compose.yml. Todo tiene un valor por defecto.
# Puerto publicado en la PC
PORT=5003
# Si se deja vacío se genera uno propio y se guarda en el volumen de fotos
JWT_SECRET=
ADMIN_USERNAME=admin
# Si se deja vacío se genera una al primer arranque: docker compose logs app | grep -i contraseña
ADMIN_PASSWORD=
# Contacto real exigido por la política de uso de Nominatim (solo para ubicar direcciones nuevas)
GEO_USER_AGENT=campana-inspecciones/1.0 (contacto: tu-email@ejemplo.com)
# Detrás de un proxy con HTTPS: INSECURE_HTTP=false y TRUST_PROXY=1
INSECURE_HTTP=true
TRUST_PROXY=
