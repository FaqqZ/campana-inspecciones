# Solo para el build del cliente (Vite). Ninguna es secreta: quedan dentro del JavaScript publicado.

# URL del servidor cuando el cliente y el API están en dominios distintos (ej. https://api.midominio.com/api).
# Vacío: el cliente llama a /api del mismo dominio (servidor que sirve el cliente, o proxy de Vite en desarrollo).
VITE_API_URL=

# true: compila el modo demostración (sin login, datos ficticios, no guarda nada). Solo para mostrar la app.
# Nunca activarlo en la versión con datos reales.
VITE_SIN_LOGIN=
